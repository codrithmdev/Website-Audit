# Supabase
SUPABASE_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Browserless.io (page capture)
BROWSERLESS_API_KEY=your-browserless-token

# OpenRouter (AI analysis — free vision model by default)
OPENROUTER_API_KEY=your-openrouter-key
# Optional: override the model (default: google/gemma-4-26b-a4b-it:free)
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Trigger.dev (background audit worker)
TRIGGER_SECRET_KEY=your-trigger-secret-key